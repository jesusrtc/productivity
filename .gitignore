# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.coverage
.env

# Content repo (managed as its own git repo, never tracked here)
content/
knowledge/

# Workspaces (popped out of content/ to the repo root; same untracked model —
# each workspace folder may hold git worktrees + per-workspace .agents/memory).
workspaces/

# Monorepo runtime (state, terminal-pastes, logs — never tracked)
repositories/
.lab/

# Log files
*.log

# macOS
.DS_Store

# Editor
.idea/
.vscode/
*.swp

# Superpowers scratch
.superpowers/

# Local runnable examples and demos (intentionally not shipped)
examples/

# html-proposal scratch: tmp/YYYY-MM-DD-<slug>.html files written by
# the html-proposal skill. Local-only working docs, never tracked.
tmp/

core/.venv/
core/.coverage
.lab-server.pid
.lab-server.port
.lab-server.log
.devserver.pid
.playwright-mcp/
.claude/settings.local.json
workspaces/*/.claude/settings.local.json

# Centralized server + client error logs
logs/

# Existing vaults may retain their pre-rename workspace directory.
projects/
